{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-execution-tool-reviews-v1.json",
  "title": "Reovim exact execution-tool semantic reviews and environment bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewed_at", "reviews", "environments"],
  "properties": {
    "schema": { "const": "reovim-execution-tool-reviews/v1" },
    "reviewed_at": { "$ref": "#/$defs/timestamp" },
    "reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/review" }
    },
    "environments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty_string" }
    },
    "invocation_family": {
      "enum": [
        "git-version",
        "git-revision",
        "git-tree",
        "git-index",
        "git-attributes",
        "linker-driver",
        "toolchain-which"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_role",
        "invocation_families",
        "required_semantics",
        "consumers",
        "product_profiles",
        "upstream",
        "license",
        "assumptions",
        "invalidators",
        "disposition",
        "review_record",
        "review_record_digest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "logical_role": { "enum": ["git", "linker_driver", "toolchain_resolver"] },
        "invocation_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/invocation_family" }
        },
        "required_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "product_profiles": { "$ref": "#/$defs/string_set" },
        "upstream": { "$ref": "#/$defs/nonempty_string" },
        "license": { "$ref": "#/$defs/nonempty_string" },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "invalidators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "disposition": { "const": "admit" },
        "review_record": { "$ref": "#/$defs/relative_path" },
        "review_record_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "runtime_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "content_digest", "size_bytes"],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/absolute_path" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review",
        "canonical_path",
        "prepared_path",
        "executable_digest",
        "executable_size_bytes",
        "version_argv",
        "version",
        "version_digest",
        "runtime_inputs"
      ],
      "properties": {
        "review": { "$ref": "#/$defs/id" },
        "canonical_path": { "$ref": "#/$defs/absolute_path" },
        "prepared_path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/absolute_path" }
          ]
        },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "executable_size_bytes": { "type": "integer", "minimum": 1 },
        "version_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "version_digest": { "$ref": "#/$defs/digest" },
        "runtime_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtime_input" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host_os", "host_arch", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "host_os": { "const": "linux" },
        "host_arch": { "const": "x86_64" },
        "bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    }
  }
}
