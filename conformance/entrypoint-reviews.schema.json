{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-entrypoint-reviews-v1.json",
  "title": "Reovim exact repository entrypoint admissions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewed_at", "reviews"],
  "properties": {
    "schema": {
      "const": "reovim-entrypoint-reviews/v1"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "direct_local_invocations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invocation"
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mechanism"],
      "properties": {
        "kind": {
          "enum": ["script", "workflow", "cargo_target"]
        },
        "path": { "$ref": "#/$defs/relative_path" },
        "package": { "$ref": "#/$defs/nonempty_string" },
        "target": { "$ref": "#/$defs/nonempty_string" },
        "mechanism": {
          "enum": ["direct-path-exec", "cargo-run-bin"]
        }
      },
      "oneOf": [
        {
          "required": ["path"],
          "properties": {
            "kind": { "const": "script" },
            "mechanism": { "const": "direct-path-exec" }
          },
          "allOf": [
            { "not": { "required": ["package"] } },
            { "not": { "required": ["target"] } }
          ]
        },
        {
          "required": ["path"],
          "properties": {
            "kind": { "const": "workflow" },
            "mechanism": { "const": "direct-path-exec" }
          },
          "allOf": [
            { "not": { "required": ["package"] } },
            { "not": { "required": ["target"] } }
          ]
        },
        {
          "required": ["package", "target"],
          "properties": {
            "kind": { "const": "cargo_target" },
            "mechanism": { "const": "cargo-run-bin" }
          },
          "allOf": [
            { "not": { "required": ["path"] } }
          ]
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direct_local_invocations",
        "disposition",
        "mechanism",
        "assumptions",
        "review_record",
        "review_record_digest"
      ],
      "properties": {
        "kind": {
          "enum": ["script", "workflow"]
        },
        "path": { "$ref": "#/$defs/relative_path" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "direct_local_invocations": {
          "$ref": "#/$defs/direct_local_invocations"
        },
        "disposition": { "const": "admit" },
        "mechanism": {
          "const": "exact-content-retained-review"
        },
        "assumptions": { "$ref": "#/$defs/assumptions" },
        "review_record": { "$ref": "#/$defs/relative_path" },
        "review_record_digest": { "$ref": "#/$defs/digest" }
      },
      "oneOf": [
        {
          "required": ["path", "content_digest"],
          "properties": {
            "kind": { "const": "script" },
            "mechanism": { "const": "exact-content-retained-review" }
          },
          "allOf": [
            { "not": { "required": ["package"] } },
            { "not": { "required": ["target"] } }
          ]
        },
        {
          "required": ["path", "content_digest"],
          "properties": {
            "kind": { "const": "workflow" },
            "mechanism": { "const": "exact-content-retained-review" }
          },
          "allOf": [
            { "not": { "required": ["package"] } },
            { "not": { "required": ["target"] } }
          ]
        }
      ]
    }
  }
}
