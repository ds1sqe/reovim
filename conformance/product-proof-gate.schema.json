{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-product-proof-gate-v1.json",
  "title": "Reovim Product proof checker fixture capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "mode",
    "revision",
    "identity_inputs",
    "limits",
    "cases",
    "processes",
    "findings",
    "result",
    "report_identity"
  ],
  "properties": {
    "schema": { "const": "reovim-product-proof-gate/v1" },
    "subject": { "$ref": "#/$defs/fixture_capability_subject" },
    "mode": { "const": "exact" },
    "revision": { "$ref": "#/$defs/revision" },
    "identity_inputs": { "$ref": "#/$defs/identity_inputs" },
    "limits": { "$ref": "#/$defs/limits" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    },
    "processes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/process" }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/finding" }
    },
    "result": { "$ref": "#/$defs/result" },
    "report_identity": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "positive_count": {
      "type": "integer",
      "minimum": 1
    },
    "nullable_string": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonempty_string" }
      ]
    },
    "nullable_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty_string" }
    },
    "fixture_capability_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "product_proof_profile"],
      "properties": {
        "kind": { "const": "checker_fixture_capability" },
        "product_proof_profile": { "const": "authored-std-lib/v1" }
      }
    },
    "active_repository_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "active_repository" }
      }
    },
    "runtime_input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "content_digest", "size_bytes"],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/nonempty_string" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "$ref": "#/$defs/positive_count" }
      }
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_path",
        "executable_digest",
        "executable_size_bytes",
        "version_argv",
        "version",
        "version_digest",
        "runtime_inputs"
      ],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/nonempty_string" },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "executable_size_bytes": { "$ref": "#/$defs/positive_count" },
        "version_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "version_digest": { "$ref": "#/$defs/digest" },
        "runtime_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtime_input_identity" }
        }
      }
    },
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "content_digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "schema": { "$ref": "#/$defs/nonempty_string" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "active_source_role_map_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "subject", "revision", "report_identity", "artifact_digest"],
      "properties": {
        "schema": { "const": "reovim-source-role-map/v2" },
        "subject": { "$ref": "#/$defs/active_repository_subject" },
        "revision": { "$ref": "#/$defs/revision" },
        "report_identity": { "$ref": "#/$defs/digest" },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "execution_tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "review",
        "canonical_path",
        "executable_digest",
        "version_argv",
        "version",
        "version_digest",
        "runtime_inputs_digest"
      ],
      "properties": {
        "environment": { "$ref": "#/$defs/nonempty_string" },
        "review": { "$ref": "#/$defs/nonempty_string" },
        "canonical_path": { "$ref": "#/$defs/nonempty_string" },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "version_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "version_digest": { "$ref": "#/$defs/digest" },
        "runtime_inputs_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "compiler_substrate_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "kind", "content_digest", "size_bytes"],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/nonempty_string" },
        "kind": { "enum": ["compiler_support", "target_libdir", "host_runtime"] },
        "content_digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "$ref": "#/$defs/positive_count" }
      }
    },
    "compiler_substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environment",
        "host_triple",
        "target_triple",
        "entries",
        "entry_count",
        "total_bytes",
        "aggregate_digest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty_string" },
        "environment": { "$ref": "#/$defs/nonempty_string" },
        "host_triple": { "$ref": "#/$defs/nonempty_string" },
        "target_triple": { "$ref": "#/$defs/nonempty_string" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/compiler_substrate_entry" }
        },
        "entry_count": { "$ref": "#/$defs/positive_count" },
        "total_bytes": { "$ref": "#/$defs/positive_count" },
        "aggregate_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "identity_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_source_role_map",
        "checker",
        "cargo",
        "rustc",
        "git",
        "source_tree_digest",
        "git_tree_digest",
        "gate_report_schema",
        "source_role_map_schema",
        "source_classification_schema",
        "workspace_topology_schema",
        "dependency_reviews_schema",
        "product_closures_schema",
        "execution_tool_reviews_schema",
        "execution_tools",
        "compiler_substrates",
        "fixture_tree_digest",
        "case_set_digest"
      ],
      "properties": {
        "active_source_role_map": { "$ref": "#/$defs/active_source_role_map_reference" },
        "checker": { "$ref": "#/$defs/tool_identity" },
        "cargo": { "$ref": "#/$defs/tool_identity" },
        "rustc": { "$ref": "#/$defs/tool_identity" },
        "git": { "$ref": "#/$defs/tool_identity" },
        "source_tree_digest": { "$ref": "#/$defs/digest" },
        "git_tree_digest": { "$ref": "#/$defs/digest" },
        "gate_report_schema": { "$ref": "#/$defs/schema_identity" },
        "source_role_map_schema": { "$ref": "#/$defs/schema_identity" },
        "source_classification_schema": { "$ref": "#/$defs/schema_identity" },
        "workspace_topology_schema": { "$ref": "#/$defs/schema_identity" },
        "dependency_reviews_schema": { "$ref": "#/$defs/schema_identity" },
        "product_closures_schema": { "$ref": "#/$defs/schema_identity" },
        "execution_tool_reviews_schema": { "$ref": "#/$defs/schema_identity" },
        "execution_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/execution_tool_identity" }
        },
        "compiler_substrates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/compiler_substrate" }
        },
        "fixture_tree_digest": { "$ref": "#/$defs/digest" },
        "case_set_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "process", "product_execution", "fixtures"],
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_bytes", "json_depth", "json_container_items", "report_bytes", "findings"],
          "properties": {
            "config_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "json_depth": { "type": "integer", "minimum": 1, "maximum": 256 },
            "json_container_items": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "report_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "findings": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdout_bytes", "stderr_bytes", "execution_deadline_ms", "supervision_deadline_ms", "tool_executable_bytes"],
          "properties": {
            "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "execution_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
            "supervision_deadline_ms": { "type": "integer", "minimum": 2, "maximum": 130000 },
            "tool_executable_bytes": { "type": "integer", "minimum": 1, "maximum": 100663296 }
          }
        },
        "product_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratch_bytes",
            "scratch_inodes",
            "process_address_space_bytes",
            "process_cpu_seconds",
            "process_open_files",
            "process_output_file_bytes",
            "core_dump_bytes",
            "cargo_json_bytes",
            "cargo_message_count",
            "wrapper_trace_bytes",
            "wrapper_argv_items",
            "wrapper_argv_bytes",
            "compiler_unit_count",
            "compiler_input_count",
            "dep_info_total_bytes",
            "artifact_total_bytes",
            "package_list_bytes",
            "package_member_count"
          ],
          "properties": {
            "scratch_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "scratch_inodes": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "process_address_space_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
            "process_cpu_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
            "process_open_files": { "type": "integer", "minimum": 1, "maximum": 256 },
            "process_output_file_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
            "core_dump_bytes": { "const": 0 },
            "cargo_json_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "cargo_message_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "wrapper_trace_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "wrapper_argv_items": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "wrapper_argv_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "compiler_unit_count": { "type": "integer", "minimum": 1, "maximum": 256 },
            "compiler_input_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "dep_info_total_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "artifact_total_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "package_list_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
            "package_member_count": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_count", "fixture_file_count", "fixture_total_bytes", "case_input_count"],
          "properties": {
            "case_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "fixture_file_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "fixture_total_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "case_input_count": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        }
      }
    },
    "fixture_input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "content_digest", "size_bytes"],
      "properties": {
        "role": { "$ref": "#/$defs/nonempty_string" },
        "path": { "$ref": "#/$defs/relative_path" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "$ref": "#/$defs/count" }
      }
    },
    "case_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_root", "artifacts", "closure_ids", "execution_environment", "command_argv", "input_digest"],
      "properties": {
        "fixture_root": { "$ref": "#/$defs/relative_path" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fixture_input_artifact" }
        },
        "closure_ids": { "$ref": "#/$defs/string_set" },
        "execution_environment": { "$ref": "#/$defs/nullable_string" },
        "command_argv": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "input_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "case_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finding_codes"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "finding_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "pass" } }
          },
          "then": { "properties": { "finding_codes": { "maxItems": 0 } } },
          "else": { "properties": { "finding_codes": { "minItems": 1 } } }
        }
      ]
    },
    "case_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "finding_codes",
        "raw_result_digest",
        "source_role_map_identity",
        "execution_digest",
        "matched"
      ],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "finding_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "raw_result_digest": { "$ref": "#/$defs/digest" },
        "source_role_map_identity": { "$ref": "#/$defs/nullable_digest" },
        "execution_digest": { "$ref": "#/$defs/nullable_digest" },
        "matched": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "pass" } }
          },
          "then": { "properties": { "finding_codes": { "maxItems": 0 } } },
          "else": { "properties": { "finding_codes": { "minItems": 1 } } }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mechanism", "fixture_tree_digest", "inputs", "expectation", "observation"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty_string" },
        "mechanism": { "$ref": "#/$defs/nonempty_string" },
        "fixture_tree_digest": { "$ref": "#/$defs/digest" },
        "inputs": { "$ref": "#/$defs/case_inputs" },
        "expectation": { "$ref": "#/$defs/case_expectation" },
        "observation": { "$ref": "#/$defs/case_observation" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "limit", "overflow", "digest"],
      "properties": {
        "bytes": { "$ref": "#/$defs/count" },
        "limit": { "$ref": "#/$defs/positive_count" },
        "overflow": { "type": "boolean" },
        "digest": { "$ref": "#/$defs/nullable_digest" }
      }
    },
    "kill_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "signal", "raced_with_exit", "group_absent"],
      "properties": {
        "attempted": { "type": "boolean" },
        "signal": { "$ref": "#/$defs/nullable_string" },
        "raced_with_exit": { "type": "boolean" },
        "group_absent": { "type": "boolean" }
      }
    },
    "reap_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leader_reaped", "descendants_reaped"],
      "properties": {
        "leader_reaped": { "type": "boolean" },
        "descendants_reaped": { "type": "boolean" }
      }
    },
    "group_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pgid", "identity_validated", "absent_after_reap"],
      "properties": {
        "pgid": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positive_count" }
          ]
        },
        "identity_validated": { "type": "boolean" },
        "absent_after_reap": { "type": "boolean" }
      }
    },
    "reader_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_joined", "stderr_joined"],
      "properties": {
        "stdout_joined": { "type": "boolean" },
        "stderr_joined": { "type": "boolean" }
      }
    },
    "deadline_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_ms", "supervision_ms", "observed_after_exit"],
      "properties": {
        "execution_ms": { "$ref": "#/$defs/positive_count" },
        "supervision_ms": { "$ref": "#/$defs/positive_count" },
        "observed_after_exit": { "type": "boolean" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "case",
        "execution",
        "tool_review",
        "tool_environment",
        "executable_digest",
        "argv",
        "termination_reason",
        "status",
        "stdout",
        "stderr",
        "kill",
        "reap",
        "group",
        "readers",
        "deadlines"
      ],
      "properties": {
        "purpose": { "$ref": "#/$defs/nonempty_string" },
        "case": { "$ref": "#/$defs/nullable_string" },
        "execution": { "$ref": "#/$defs/nullable_string" },
        "tool_review": { "$ref": "#/$defs/nullable_string" },
        "tool_environment": { "$ref": "#/$defs/nullable_string" },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "termination_reason": {
          "enum": ["exited", "stdout_limit", "stderr_limit", "deadline", "setup_failure", "cancelled"]
        },
        "status": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        },
        "stdout": { "$ref": "#/$defs/capture" },
        "stderr": { "$ref": "#/$defs/capture" },
        "kill": { "$ref": "#/$defs/kill_evidence" },
        "reap": { "$ref": "#/$defs/reap_evidence" },
        "group": { "$ref": "#/$defs/group_evidence" },
        "readers": { "$ref": "#/$defs/reader_evidence" },
        "deadlines": { "$ref": "#/$defs/deadline_evidence" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "path", "message"],
      "properties": {
        "stage": { "$ref": "#/$defs/nonempty_string" },
        "code": { "$ref": "#/$defs/nonempty_string" },
        "path": { "$ref": "#/$defs/nullable_string" },
        "message": { "$ref": "#/$defs/nonempty_string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finding_count", "case_count", "matched_case_count"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "finding_count": { "$ref": "#/$defs/count" },
        "case_count": { "$ref": "#/$defs/positive_count" },
        "matched_case_count": { "$ref": "#/$defs/count" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "pass" } }
          },
          "then": {
            "properties": { "finding_count": { "const": 0 } }
          }
        }
      ]
    }
  }
}
