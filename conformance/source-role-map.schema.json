{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-source-role-map-v1.json",
  "title": "Reovim generated source role map evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "revision",
    "identity_inputs",
    "limits",
    "classifications",
    "exclusions",
    "packages",
    "edges",
    "dependency_reachability",
    "processes",
    "findings",
    "result",
    "report_identity"
  ],
  "properties": {
    "schema": {
      "const": "reovim-source-role-map/v1"
    },
    "mode": {
      "enum": ["candidate", "exact"]
    },
    "revision": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/revision" }
      ]
    },
    "identity_inputs": {
      "$ref": "#/$defs/identity_inputs"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "classifications": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/classification" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/edge" }
    },
    "dependency_reachability": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency_reachability" }
    },
    "processes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/process" }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/finding" }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "report_identity": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "candidate" } }
      },
      "then": {
        "properties": {
          "revision": { "type": "null" },
          "identity_inputs": {
            "properties": {
              "git": { "type": "null" },
              "git_tree_digest": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "exact" } }
      },
      "then": {
        "properties": {
          "revision": { "$ref": "#/$defs/revision" },
          "identity_inputs": {
            "properties": {
              "git": { "$ref": "#/$defs/tool_identity" },
              "git_tree_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "source_owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "repository_tooling" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "role"],
          "properties": {
            "kind": { "const": "product" },
            "role": { "$ref": "#/$defs/product_role" }
          }
        }
      ]
    },
    "product_role": {
      "enum": [
        "Foundation",
        "Kernel Interface",
        "Kernel Core",
        "Kernel Runtime",
        "Public SDKs",
        "Concrete policy",
        "Resource Adapter",
        "Host Adapter",
        "External Protocol Binding",
        "Protocol Adapter",
        "Extension Adapter",
        "Extension Engine Adapter",
        "Client Family",
        "Client Runtime",
        "Presentation Adapter",
        "Assembly"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "digest", "digest_subject"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonempty_string" },
        "digest": { "$ref": "#/$defs/digest" },
        "digest_subject": { "$ref": "#/$defs/digest_subject" }
      }
    },
    "digest_subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": { "const": "paths" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relative_path" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "classified_content" }
          }
        }
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_digest",
        "source_owner",
        "source_provenance",
        "source_use",
        "upstream"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "source_owner": { "$ref": "#/$defs/source_owner" },
        "source_provenance": {
          "enum": ["authored", "generated", "vendored"]
        },
        "source_use": {
          "enum": ["production", "test", "example", "tool", "build_output"]
        },
        "upstream": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/upstream" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["source_provenance"],
            "properties": { "source_provenance": { "const": "authored" } }
          },
          "then": {
            "properties": { "upstream": { "type": "null" } }
          }
        },
        {
          "if": {
            "required": ["source_provenance"],
            "properties": {
              "source_provenance": { "enum": ["generated", "vendored"] }
            }
          },
          "then": {
            "properties": { "upstream": { "$ref": "#/$defs/upstream" } }
          }
        },
        {
          "if": {
            "required": ["source_provenance"],
            "properties": { "source_provenance": { "const": "generated" } }
          },
          "then": {
            "properties": {
              "upstream": {
                "properties": {
                  "digest_subject": {
                    "properties": { "kind": { "const": "paths" } }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["source_provenance"],
            "properties": { "source_provenance": { "const": "vendored" } }
          },
          "then": {
            "properties": {
              "upstream": {
                "properties": {
                  "digest_subject": {
                    "properties": {
                      "kind": { "const": "classified_content" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["source_owner"],
            "properties": {
              "source_owner": {
                "required": ["kind"],
                "properties": { "kind": { "const": "repository_tooling" } }
              }
            }
          },
          "then": {
            "properties": {
              "source_use": {
                "enum": ["test", "example", "tool", "build_output"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["source_owner"],
            "properties": {
              "source_owner": {
                "required": ["kind"],
                "properties": { "kind": { "const": "product" } }
              }
            }
          },
          "then": {
            "properties": {
              "source_use": { "enum": ["production", "test", "example"] }
            }
          }
        },
        {
          "if": {
            "required": ["source_use"],
            "properties": { "source_use": { "const": "build_output" } }
          },
          "then": {
            "properties": {
              "source_provenance": { "const": "generated" }
            }
          }
        }
      ]
    },
    "exclusion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix", "kind"],
          "properties": {
            "prefix": { "const": ".git" },
            "kind": { "const": "vcs_metadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix", "kind"],
          "properties": {
            "prefix": { "const": "target" },
            "kind": { "const": "transient_build_output" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix", "kind"],
          "properties": {
            "prefix": { "const": "tmp" },
            "kind": { "const": "working_notes" }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_bytes",
        "json_depth",
        "json_container_items",
        "metadata_stdout_bytes",
        "child_stderr_bytes",
        "child_deadline_ms",
        "child_supervision_deadline_ms",
        "tool_executable_bytes",
        "report_bytes",
        "source_entry_count",
        "directory_entry_count",
        "source_file_count",
        "source_total_bytes",
        "source_file_bytes",
        "path_bytes",
        "syntax_item_expr_type_visits",
        "findings"
      ],
      "properties": {
        "config_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "json_depth": { "type": "integer", "minimum": 1, "maximum": 128 },
        "json_container_items": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "metadata_stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "child_stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "child_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 55000 },
        "child_supervision_deadline_ms": { "type": "integer", "minimum": 2, "maximum": 60000 },
        "tool_executable_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "report_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "source_entry_count": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "directory_entry_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "source_file_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "source_total_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "source_file_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "path_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "syntax_item_expr_type_visits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "findings": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_path",
        "executable_digest",
        "version",
        "version_digest"
      ],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/nonempty_string" },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "version_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "lockfile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "all_features",
        "no_default_features",
        "features",
        "metadata_digest"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty_string" },
        "target": { "$ref": "#/$defs/nonempty_string" },
        "all_features": { "type": "boolean" },
        "no_default_features": { "type": "boolean" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "metadata_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "required": ["all_features"],
            "properties": { "all_features": { "const": true } }
          },
          "then": {
            "properties": {
              "no_default_features": { "const": false },
              "features": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "identity_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_digest",
        "policy_schema_digest",
        "topology_digest",
        "topology_schema_digest",
        "entrypoint_reviews_digest",
        "entrypoint_reviews_schema_digest",
        "dependency_reviews_digest",
        "dependency_reviews_schema_digest",
        "report_schema_digest",
        "lockfiles",
        "source_tree_digest",
        "checker_digest",
        "cargo",
        "cargo_home_config",
        "cargo_working_directory",
        "cargo_working_directory_config",
        "rustc",
        "git",
        "git_tree_digest",
        "profiles"
      ],
      "properties": {
        "policy_digest": { "$ref": "#/$defs/digest" },
        "policy_schema_digest": { "$ref": "#/$defs/digest" },
        "topology_digest": { "$ref": "#/$defs/digest" },
        "topology_schema_digest": { "$ref": "#/$defs/digest" },
        "entrypoint_reviews_digest": { "$ref": "#/$defs/digest" },
        "entrypoint_reviews_schema_digest": { "$ref": "#/$defs/digest" },
        "dependency_reviews_digest": { "$ref": "#/$defs/digest" },
        "dependency_reviews_schema_digest": { "$ref": "#/$defs/digest" },
        "report_schema_digest": { "$ref": "#/$defs/digest" },
        "lockfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lockfile_identity" }
        },
        "source_tree_digest": { "$ref": "#/$defs/digest" },
        "checker_digest": { "$ref": "#/$defs/digest" },
        "cargo": { "$ref": "#/$defs/tool_identity" },
        "cargo_home_config": { "const": "absent" },
        "cargo_working_directory": { "const": "/" },
        "cargo_working_directory_config": { "const": "absent" },
        "rustc": { "$ref": "#/$defs/tool_identity" },
        "git": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/tool_identity" }
          ]
        },
        "git_tree_digest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile_identity" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "crate_types", "src_path"],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty_string" },
        "kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "crate_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        },
        "src_path": { "$ref": "#/$defs/relative_path" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "name", "manifest", "owners", "targets"],
      "properties": {
        "profile": { "$ref": "#/$defs/nonempty_string" },
        "name": { "$ref": "#/$defs/nonempty_string" },
        "manifest": { "$ref": "#/$defs/relative_path" },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_owner" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "consumer",
        "provider",
        "kind",
        "target",
        "consumer_owners",
        "provider_owners",
        "decision"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/nonempty_string" },
        "consumer": { "$ref": "#/$defs/nonempty_string" },
        "provider": { "$ref": "#/$defs/nonempty_string" },
        "kind": { "enum": ["normal", "development", "build"] },
        "target": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonempty_string" }
          ]
        },
        "consumer_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_owner" }
        },
        "provider_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_owner" }
        },
        "decision": {
          "enum": [
            "admitted_same_owner",
            "admitted_product_edge",
            "forbidden_partition",
            "forbidden_product_edge"
          ]
        }
      }
    },
    "dependency_reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "package", "members"],
      "properties": {
        "profile": { "$ref": "#/$defs/nonempty_string" },
        "package": { "$ref": "#/$defs/nonempty_string" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_string" }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "profile",
        "executable_digest",
        "termination_reason",
        "status",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_limit",
        "stderr_limit",
        "stdout_overflow",
        "stderr_overflow",
        "kill_attempted",
        "kill_raced_with_exit",
        "limit_observed_after_exit",
        "reaped",
        "readers_joined"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "cargo_version",
            "rustc_version",
            "cargo_metadata",
            "cargo_metadata_final",
            "git_version",
            "git_root",
            "git_head",
            "git_ls_tree",
            "git_object_format",
            "git_index_entries",
            "git_info_attributes_path",
            "git_pre_metadata_version",
            "git_pre_metadata_root",
            "git_pre_metadata_head",
            "git_pre_metadata_ls_tree",
            "git_pre_metadata_object_format",
            "git_pre_metadata_index_entries",
            "git_pre_metadata_info_attributes_path",
            "git_final_version",
            "git_final_root",
            "git_final_head",
            "git_final_ls_tree",
            "git_final_object_format",
            "git_final_index_entries",
            "git_final_info_attributes_path"
          ]
        },
        "profile": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonempty_string" }
          ]
        },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "termination_reason": {
          "enum": ["exited", "stdout_limit", "stderr_limit", "deadline"]
        },
        "status": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        },
        "stdout_bytes": { "$ref": "#/$defs/count" },
        "stderr_bytes": { "$ref": "#/$defs/count" },
        "stdout_limit": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "stderr_limit": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "stdout_overflow": { "type": "boolean" },
        "stderr_overflow": { "type": "boolean" },
        "kill_attempted": { "type": "boolean" },
        "kill_raced_with_exit": { "type": "boolean" },
        "limit_observed_after_exit": { "type": "boolean" },
        "reaped": { "type": "boolean" },
        "readers_joined": { "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "path", "message"],
      "properties": {
        "stage": { "$ref": "#/$defs/nonempty_string" },
        "code": { "$ref": "#/$defs/nonempty_string" },
        "path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonempty_string" }
          ]
        },
        "message": { "$ref": "#/$defs/nonempty_string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finding_count"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "finding_count": { "$ref": "#/$defs/count" }
      }
    }
  }
}
