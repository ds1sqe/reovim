{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-workspace-topology-v2.json",
  "title": "Reovim exact multi-workspace topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "limits", "repository_entrypoints", "workspaces"],
  "properties": {
    "schema": { "const": "reovim-workspace-topology/v2" },
    "limits": { "$ref": "#/$defs/limits" },
    "repository_entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repository_entrypoint" }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workspace" }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "root_path": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/relative_path" }
      ]
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty_string" }
    },
    "path_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "inventory", "process", "product_execution"],
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_bytes", "json_depth", "json_container_items", "report_bytes", "findings"],
          "properties": {
            "config_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "json_depth": { "type": "integer", "minimum": 1, "maximum": 256 },
            "json_container_items": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "report_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "findings": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_entry_count",
            "directory_entry_count",
            "source_file_count",
            "source_total_bytes",
            "source_file_bytes",
            "path_bytes",
            "syntax_item_expr_type_visits"
          ],
          "properties": {
            "source_entry_count": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "directory_entry_count": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "source_file_count": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "source_total_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
            "source_file_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
            "path_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "syntax_item_expr_type_visits": { "type": "integer", "minimum": 1, "maximum": 2000000 }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stdout_bytes",
            "stderr_bytes",
            "execution_deadline_ms",
            "supervision_deadline_ms",
            "tool_executable_bytes"
          ],
          "properties": {
            "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "execution_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
            "supervision_deadline_ms": { "type": "integer", "minimum": 2, "maximum": 130000 },
            "tool_executable_bytes": { "type": "integer", "minimum": 1, "maximum": 100663296 }
          }
        },
        "product_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratch_bytes",
            "scratch_inodes",
            "process_address_space_bytes",
            "process_cpu_seconds",
            "process_open_files",
            "process_output_file_bytes",
            "core_dump_bytes",
            "exposure_entry_count",
            "compiler_substrate_entry_count",
            "compiler_substrate_total_bytes",
            "cargo_json_bytes",
            "cargo_message_count",
            "wrapper_trace_bytes",
            "wrapper_argv_items",
            "wrapper_argv_bytes",
            "compiler_unit_count",
            "compiler_input_count",
            "dep_info_file_bytes",
            "dep_info_total_bytes",
            "artifact_count",
            "artifact_total_bytes",
            "package_list_bytes",
            "package_member_count",
            "public_item_count",
            "environment_dependency_count"
          ],
          "properties": {
            "scratch_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "scratch_inodes": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "process_address_space_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
            "process_cpu_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
            "process_open_files": { "type": "integer", "minimum": 1, "maximum": 256 },
            "process_output_file_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
            "core_dump_bytes": { "const": 0 },
            "exposure_entry_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "compiler_substrate_entry_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "compiler_substrate_total_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "cargo_json_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "cargo_message_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "wrapper_trace_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "wrapper_argv_items": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "wrapper_argv_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "compiler_unit_count": { "type": "integer", "minimum": 1, "maximum": 256 },
            "compiler_input_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "dep_info_file_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
            "dep_info_total_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "artifact_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "artifact_total_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "package_list_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
            "package_member_count": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "public_item_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "environment_dependency_count": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        }
      }
    },
    "metadata_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_triple", "all_features", "no_default_features", "features"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target_triple": { "$ref": "#/$defs/nonempty_string" },
        "all_features": { "type": "boolean" },
        "no_default_features": { "type": "boolean" },
        "features": { "$ref": "#/$defs/string_set" }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "all_features": { "const": true },
              "no_default_features": { "const": true }
            },
            "required": ["all_features", "no_default_features"]
          }
        },
        {
          "if": {
            "properties": { "all_features": { "const": true } },
            "required": ["all_features"]
          },
          "then": {
            "properties": { "features": { "maxItems": 0 } }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "crate_types", "src_path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonempty_string" },
        "kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["lib", "rlib", "bin", "test", "example", "bench", "custom-build", "proc-macro", "dylib", "cdylib", "staticlib"]
          }
        },
        "crate_types": { "$ref": "#/$defs/string_set" },
        "src_path": { "$ref": "#/$defs/relative_path" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "manifest", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonempty_string" },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "manifest": { "$ref": "#/$defs/relative_path" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "partition",
        "root",
        "workspace_manifest",
        "lockfile",
        "members",
        "cargo_config_files",
        "build_scripts",
        "custom_target_specs",
        "linker_assets",
        "metadata_profiles",
        "packages"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "partition": { "enum": ["repository_tooling", "product"] },
        "root": { "$ref": "#/$defs/root_path" },
        "workspace_manifest": { "$ref": "#/$defs/relative_path" },
        "lockfile": { "$ref": "#/$defs/relative_path" },
        "members": { "$ref": "#/$defs/path_set" },
        "cargo_config_files": { "$ref": "#/$defs/path_set" },
        "build_scripts": { "$ref": "#/$defs/path_set" },
        "custom_target_specs": { "$ref": "#/$defs/path_set" },
        "linker_assets": { "$ref": "#/$defs/path_set" },
        "metadata_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/metadata_profile" }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package" }
        }
      }
    },
    "repository_entrypoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "content_digest"],
          "properties": {
            "kind": { "enum": ["script", "workflow"] },
            "path": { "$ref": "#/$defs/relative_path" },
            "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package", "target"],
          "properties": {
            "kind": { "const": "cargo_target" },
            "package": { "$ref": "#/$defs/nonempty_string" },
            "target": { "$ref": "#/$defs/nonempty_string" }
          }
        }
      ]
    }
  }
}
