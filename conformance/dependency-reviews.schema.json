{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-dependency-reviews-v2.json",
  "title": "Reovim exact per-workspace dependency admissions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewed_at", "workspaces"],
  "properties": {
    "schema": { "const": "reovim-dependency-reviews/v2" },
    "reviewed_at": { "$ref": "#/$defs/timestamp" },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workspace_review" }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "workspace_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workspace", "package"],
      "properties": {
        "kind": { "const": "workspace_package" },
        "workspace": { "$ref": "#/$defs/id" },
        "package": { "$ref": "#/$defs/id" }
      }
    },
    "external_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "source"],
      "properties": {
        "kind": { "const": "external_package" },
        "name": { "$ref": "#/$defs/nonempty_string" },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "source": { "$ref": "#/$defs/nonempty_string" }
      }
    },
    "resolved_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "consumer", "dependency_name", "kind", "target"],
      "properties": {
        "profile": { "$ref": "#/$defs/id" },
        "consumer": {
          "oneOf": [
            { "$ref": "#/$defs/workspace_consumer" },
            { "$ref": "#/$defs/external_consumer" }
          ]
        },
        "dependency_name": { "$ref": "#/$defs/nonempty_string" },
        "kind": { "enum": ["normal", "development", "build"] },
        "target": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonempty_string" }
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source",
        "checksum",
        "license",
        "resolved_uses",
        "disposition",
        "review_record",
        "review_record_digest"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty_string" },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "source": { "$ref": "#/$defs/nonempty_string" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "license": { "$ref": "#/$defs/nonempty_string" },
        "resolved_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolved_use" }
        },
        "disposition": { "const": "admit" },
        "review_record": { "$ref": "#/$defs/relative_path" },
        "review_record_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "workspace_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "lockfile", "lock_digest", "admissions"],
      "properties": {
        "workspace": { "$ref": "#/$defs/id" },
        "lockfile": { "$ref": "#/$defs/relative_path" },
        "lock_digest": { "$ref": "#/$defs/digest" },
        "admissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/admission" }
        }
      }
    }
  }
}
