{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reovim.dev/schema/reovim-dependency-reviews-v1.json",
  "title": "Reovim exact third-party dependency admissions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewed_at", "lock_digest", "admissions"],
  "properties": {
    "schema": {
      "const": "reovim-dependency-reviews/v1"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "admissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/admission"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)(?!.*\\u0000).+$",
      "not": { "const": "." }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source",
        "checksum",
        "license",
        "resolved_consumers",
        "resolved_profiles",
        "disposition",
        "review_record"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty_string" },
        "version": { "$ref": "#/$defs/nonempty_string" },
        "source": { "$ref": "#/$defs/nonempty_string" },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": { "$ref": "#/$defs/nonempty_string" },
        "resolved_consumers": { "$ref": "#/$defs/string_set" },
        "resolved_profiles": { "$ref": "#/$defs/string_set" },
        "disposition": { "const": "admit" },
        "review_record": { "$ref": "#/$defs/relative_path" }
      }
    }
  }
}
