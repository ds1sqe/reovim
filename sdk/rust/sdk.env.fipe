##! Named text values; an empty value is still set.
##! env api, version 1.
## The resource at `path` that offers this api.
pub at: (path: String) -> Rd<sdk.env>
## The Entry type.
pub type Entry {
    ## The set field.
    pub set: Bool,
    ## The value field.
    pub value: String,
}
## The Set type.
pub type Set {
    ## The key field.
    pub key: String,
    ## The value field.
    pub value: String,
}
## Needs READ.
pub get: (h: Rd<sdk.env>) -> (key: String) -> Entry
## Needs WRITE.
pub set: (h: Rd<sdk.env>) -> (key: String) -> (value: String) -> ()
