{
  "name": "reovim-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:wasm": "cd ../../shared/clients/model && wasm-pack build --target web --features wasm --out-dir ../../../clients/web/pkg",
    "prebuild": "npm run build:wasm",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.0",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.0"
  }
}
