{
  "name": "reovim-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "reovim-web": "./dist/cli/capture.js"
  },
  "scripts": {
    "build:cli": "npx tsc -p tsconfig.cli.json",
    "build:wasm": "cd ../lib/model && wasm-pack build --target web --features wasm && rm -rf ../../web/pkg && mv pkg ../../web/",
    "prebuild": "npm run build:wasm",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "generate": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.0",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/connect-node": "^1.7.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.0"
  }
}
